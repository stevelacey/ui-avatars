{
    "name": "lasserafn/ui-avatars",
    "description": "Generate avatars with initials from names",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/stevelacey/php-initials.git"
        }
    ],
    "require": {
        "lasserafn/php-initial-avatar-generator": "^4.1",
        "lasserafn/php-initials": "dev-fix-hyphenated-names as 3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "LasseRafn\\UiAvatars\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LasseRafn\\UiAvatars\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
